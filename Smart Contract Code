pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC721/extensions/ERC721URIStorage.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract AdvancedAICollection is ERC721URIStorage, Ownable {
    uint256 private _nextTokenId = 1;
    uint256 public constant MINT_PRICE = 0.001 ether;

    // Maps Token ID to On-Chain Random Rarity Score (1 - 100)
    mapping(uint256 => uint256) public tokenRarity;

    event NFTMinted(address indexed minter, uint256 indexed tokenId, uint256 rarityScore);

    constructor() ERC721("Advanced AI Collection", "AAIC") Ownable(msg.sender) {}

    function mintNFT(string memory tokenURI) public payable returns (uint256) {
        require(msg.value >= MINT_PRICE, "Insufficient ETH sent");

        uint256 tokenId = _nextTokenId;
        _nextTokenId++;

        // 1. Mint the token
        _safeMint(msg.sender, tokenId);
        _setTokenURI(tokenId, tokenURI);

        // 2. Generate and assign on-chain random rarity score
        uint256 rarity = _generateRandomScore(tokenId);
        tokenRarity[tokenId] = rarity;

        emit NFTMinted(msg.sender, tokenId, rarity);

        return tokenId;
    }

    // Pseudo-random generation using on-chain block variables
    function _generateRandomScore(uint256 seed) internal view returns (uint256) {
        uint256 randomHash = uint256(
            keccak256(
                abi.encodePacked(
                    block.prevrandao, // Consensus randomness value
                    block.timestamp,  // Block timestamp
                    msg.sender,       // Minter wallet address
                    seed              // Token ID
                )
            )
        );

        return (randomHash % 100) + 1; // Returns a number between 1 and 100
    }

    // Modern Solidity withdrawal method avoiding deprecated transfer()
    function withdraw() public onlyOwner {
        uint256 balance = address(this).balance;
        require(balance > 0, "No balance to withdraw");

        (bool success, ) = payable(owner()).call{value: balance}("");
        require(success, "ETH transfer failed");
    }
}
